---
import '@styles/global.css';
import Header from '@components/ui/Header.astro';

interface Props {
  title: string,
  subtitle: string,
  bgImage: string
}
const {title, subtitle, bgImage} = Astro.props;
---


<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet">
    <title>Cafetería desde 1939: </title>
  </head>
  <body>
    <Header
    bgImage={bgImage}
    subtitle={subtitle}/>
    <main class="main" >
      <slot/>
    </main>
      <slot name="after-main.content"/>
  </body>
</html>