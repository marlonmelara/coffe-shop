---
import Logo from '@assets/logo.svg'
import MainNav from './MainNav.astro';

interface Props {
  bgImage: string,
  subtitle: string
}

const { subtitle, bgImage } = Astro.props;
---

<header class="header">
  <div class="header__div" style={{ backgroundImage: `url(${bgImage})` }}></div>
  <div class="header__div header__div--overlay"></div>

  <div class="header__nav">
    <a href="/">
    <Logo class="header__svg" />
    </a>
    <MainNav /> </div>
    <h1 class="header__h1">{subtitle}</h1>
</header>